{
  "manifest_version": 3,
  "name": "ValRecall",
  "version": "0.1.0",
  "description": "把 B 站、YouTube 和抖音视频里的学习片段存下来，在本机安排复习。",
  "permissions": ["activeTab", "alarms", "notifications", "scripting", "storage", "sidePanel"],
  "optional_permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://www.bilibili.com/video/*",
    "https://bilibili.com/video/*",
    "https://www.bilibili.com/list/watchlater*",
    "https://www.youtube.com/watch*",
    "https://www.douyin.com/video/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://bilibili.com/video/*",
        "https://www.bilibili.com/list/watchlater*",
        "https://www.youtube.com/watch*",
        "https://www.douyin.com/video/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "dashboard.html",
  "action": {
    "default_title": "打开 ValRecall 学习主页",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "capture-learning-moment": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "捕获当前视频的学习片段"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
